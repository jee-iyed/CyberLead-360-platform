# CyberLead 360 configuration. Copy to .env and adjust. NEVER commit .env.

APP_ENV=development
OPERATOR_NAME=demo.user
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text | json

# Database — SQLite by default (no server needed). PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://cyberlead:change-me@localhost:5432/cyberlead360
DATABASE_URL=sqlite:///./data/cyberlead360.db
AUTO_MIGRATE=true

# Uploads
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=5000

# AI — leave LLM_PROVIDER=none for deterministic template mode (no key needed)
LLM_PROVIDER=none               # none | anthropic | openai_compatible
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=                # e.g. http://localhost:11434/v1 (Ollama) or
                                #   https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini)
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_INPUT_CHARS=12000
LLM_INPUT_PRICE_PER_MTOK=0      # set to display cost estimates (USD per 1M tokens)
LLM_OUTPUT_PRICE_PER_MTOK=0

# Public-source retrieval (disabled by default)
ENABLE_WEB_RETRIEVAL=false
RETRIEVAL_ALLOW_ANY_PUBLIC_HOST=false
RETRIEVAL_USER_AGENT=CyberLead360-ResearchBot/1.0 (+https://example.com/bot)
RETRIEVAL_TIMEOUT_SECONDS=10
RETRIEVAL_MAX_BYTES=1000000
RETRIEVAL_MIN_INTERVAL_SECONDS=2

# Privacy
CONTACT_RETENTION_DAYS=730
FACT_FRESHNESS_DAYS=365
